{
  "name": "waitfeed-dev",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Dev harness for the WaitFeed plugin — typecheck and tests. The published npm package lives in .opencode/plugins/waitfeed.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "cd .opencode/plugins/waitfeed && npm pack --dry-run",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
