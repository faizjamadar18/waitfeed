  "keywords": [
    "opencode",
    "opencode-plugin",
    "news",
    "ticker",
    "reader",
    "hacker-news",
    "rss",
    "tui",
    "terminal"
  ],
  "license": "MIT",
  "author": "faizjamadar18 (https://github.com/faizjamadar18)",
  "homepage": "https://github.com/faizjamadar18/waitfeed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizjamadar18/waitfeed.git",
    "directory": ".opencode/plugins/waitfeed"
  },
  "bugs": {
    "url": "https://github.com/faizjamadar18/waitfeed/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
