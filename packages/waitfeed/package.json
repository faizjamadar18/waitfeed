  "keywords": [
    "opencode",
    "opencode-plugin",
    "antigravity",
    "agy",
    "claude-code",
    "news",
    "ticker",
    "reader",
    "hacker-news",
    "rss",
    "tui",
    "terminal"
  ],
  "license": "MIT",
  "author": "faizjamadar18 (https://github.com/faizjamadar18)",
  "homepage": "https://github.com/faizjamadar18/waitfeed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizjamadar18/waitfeed.git",
    "directory": "packages/waitfeed"
  },
  "bugs": {
    "url": "https://github.com/faizjamadar18/waitfeed/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./opencode/index.ts",
  "bin": {
    "waitfeed": "bin.mjs"
