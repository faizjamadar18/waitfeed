# Normalize line endings to LF in the repository for every text file.
# This repo is developed on Windows, so without this the working tree drifts
# between CRLF and LF across machines and contributors.
* text=auto eol=lf

# Binary assets — git must never attempt to normalize these.
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# Lockfiles are generated — keep them out of language statistics and
# collapse them in diffs so they don't drown review.
package-lock.json linguist-generated=true
frontend/package-lock.json linguist-generated=true
